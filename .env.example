# Prisma / PostgreSQL
DATABASE_URL="postgresql://gestao:gestao@localhost:5432/gestao_estoque?schema=public"

# Auth.js — gere um valor forte em produção com: openssl rand -base64 32
AUTH_SECRET="troque-este-valor-em-producao"
NEXTAUTH_URL="http://localhost:3000"

# Conta master (perfil de plataforma, cria Grupos/Empresas via /admin) — usada
# por prisma/seed.ts. Sem essas variáveis, o seed cai no login de teste
# master@exemplo.com / master123.
MASTER_EMAIL="master@exemplo.com"
MASTER_SENHA="troque-esta-senha"
