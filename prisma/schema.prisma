// Prisma schema — Sistema de Controle de Estoque (Kardex / Média Ponderada)
// Modelagem baseada em modelo-de-dados-sistema-estoque-kardex.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  master
  admin
  estoquista
  vendedor
}

enum TipoPessoa {
  fisica
  juridica
}

enum TipoCliente {
  varejista
  atacadista
}

enum EstadoConservacao {
  excelente
  bom
  regular
  para_reparo
}

enum TipoMovimento {
  compra
  devolucao_cliente
  ajuste_entrada
  transferencia_entrada
  venda
  devolucao_fornecedor
  perda_avaria
  uso_interno
  ajuste_saida
  transferencia_saida
  os_saida
}

enum StatusOS {
  aberta
  em_andamento
  concluida
  cancelada
}

enum StatusOrcamento {
  aberto
  fechado
}

enum TipoComissao {
  percentual
  fixa
}

enum TipoLancamento {
  compra
  devolucao_cliente
  ajuste_entrada
  venda
  devolucao_fornecedor
  perda_avaria
  uso_interno
  ajuste_saida
  transferencia
}

enum StatusLancamento {
  aberto
  fechado
}

/// Topo da hierarquia multi-tenant: totalmente isolado de outros grupos (sem
/// nenhuma visibilidade cruzada). Criado apenas pelo usuário master (perfil
/// de plataforma, sem grupo) através da área /admin.
model GrupoEmpresarial {
  id       String   @id @default(uuid())
  nome     String
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  empresas       Empresa[]
  usuarios       Usuario[]
  categorias     Categoria[]
  unidadesMedida UnidadeMedida[]
  tabelasPreco   TabelaPreco[]
  produtos       Produto[]
  servicos       Servico[]
  fornecedores   Fornecedor[]
  clientes       Cliente[]
  vendedores     Vendedor[]
  movimentacoes  Movimentacao[]
  ordensServico  OrdemServico[]
  orcamentos     Orcamento[]
  lancamentos    Lancamento[]

  mascarasPlanoFinanceiro MascaraPlanoFinanceiro[]
  planosFinanceiros       PlanoFinanceiro[]
  mascarasCentroCusto     MascaraCentroCusto[]
  centrosCusto            CentroCusto[]
  mascarasProcesso        MascaraProcesso[]

  @@map("grupos_empresariais")
}

model Empresa {
  id       String   @id @default(uuid())
  grupoId  String   @map("grupo_id")
  nome     String
  cnpj     String?
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  grupo           GrupoEmpresarial @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  depositos       Deposito[]
  usuarios        UsuarioEmpresa[]
  produtoEstoques ProdutoEstoque[]
  movimentacoes   Movimentacao[]
  ordensServico   OrdemServico[]
  orcamentos      Orcamento[]
  lancamentos     Lancamento[]

  fechamentosDiarios       FechamentoDiario[]
  contasFinanceiras        ContaFinanceira[]
  processosFinanceiros     Processo[]
  parametroFinanceiro      ParametroFinanceiro?
  lancamentosFinanceiros   LancamentoFinanceiro[]
  transferenciasContas     TransferenciaEntreContas[]
  movimentosAplicacao      MovimentoAplicacao[]
  movimentacoesFinanceiras MovimentacaoFinanceira[]

  @@map("empresas")
}

/// Acesso restrito: quais Empresas (dentro do grupo do usuário) cada Usuario
/// pode escolher no login — não é automático a todas as empresas do grupo.
model UsuarioEmpresa {
  id               String   @id @default(uuid())
  usuarioId        String   @map("usuario_id")
  empresaId        String   @map("empresa_id")
  depositoPadraoId String?  @map("deposito_padrao_id")
  criadoEm         DateTime @default(now()) @map("criado_em")

  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa        Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  depositoPadrao Deposito? @relation("UsuarioEmpresaDepositoPadrao", fields: [depositoPadraoId], references: [id], onDelete: Restrict)

  @@unique([usuarioId, empresaId])
  @@map("usuario_empresas")
}

model Deposito {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  nome      String
  endereco  String?
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa               Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuarioEmpresasPadrao UsuarioEmpresa[] @relation("UsuarioEmpresaDepositoPadrao")
  produtoEstoques       ProdutoEstoque[]
  movimentacoes         Movimentacao[]
  ordensServico         OrdemServico[]
  orcamentos            Orcamento[]
  lancamentos           Lancamento[]     @relation("LancamentoDeposito")
  lancamentosOrigem     Lancamento[]     @relation("LancamentoDepositoOrigem")
  lancamentosDestino    Lancamento[]     @relation("LancamentoDepositoDestino")

  @@map("depositos")
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  perfil    Perfil   @default(vendedor)
  grupoId   String?  @map("grupo_id") // NULL somente para perfil = master (usuário de plataforma)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  grupo          GrupoEmpresarial? @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  empresasAcesso UsuarioEmpresa[]
  movimentacoes  Movimentacao[]
  ordensServico  OrdemServico[]
  orcamentos     Orcamento[]
  lancamentos    Lancamento[]

  @@map("usuarios")
}

model Fornecedor {
  id         String     @id @default(uuid())
  grupoId    String     @map("grupo_id")
  nome       String
  tipoPessoa TipoPessoa @map("tipo_pessoa")
  documento  String?
  telefone   String?
  email      String?
  criadoEm   DateTime   @default(now()) @map("criado_em")

  grupo         GrupoEmpresarial @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  movimentacoes Movimentacao[]
  orcamentos    Orcamento[]
  lancamentos   Lancamento[]

  lancamentosFinanceiros     LancamentoFinanceiro[]
  movimentacoesFinanceiras   MovimentacaoFinanceira[]
  dadosChequeComoTerceiro    DadosCheque[]
  saldosAdiantamento         SaldoAdiantamentoTerceiro[]
  transferenciasAdiantamento TransferenciaEntreContas[]

  @@map("fornecedores")
}

model Cliente {
  id                  String      @id @default(uuid())
  grupoId             String      @map("grupo_id")
  nome                String
  tipoCliente         TipoCliente @map("tipo_cliente")
  telefone            String?
  email               String?
  tabelaPrecoPadraoId String?     @map("tabela_preco_padrao_id")
  criadoEm            DateTime    @default(now()) @map("criado_em")

  grupo             GrupoEmpresarial @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  tabelaPrecoPadrao TabelaPreco?     @relation(fields: [tabelaPrecoPadraoId], references: [id])
  movimentacoes     Movimentacao[]
  ordensServico     OrdemServico[]
  lancamentos       Lancamento[]

  lancamentosFinanceiros     LancamentoFinanceiro[]
  movimentacoesFinanceiras   MovimentacaoFinanceira[]
  dadosChequeComoTerceiro    DadosCheque[]
  saldosAdiantamento         SaldoAdiantamentoTerceiro[]
  transferenciasAdiantamento TransferenciaEntreContas[]

  @@map("clientes")
}

/// Vendedor indicado numa venda ou OS para fins de comissionamento e futuros
/// relatórios de produtividade — distinto do Perfil "vendedor" (que é sobre
/// permissão de acesso ao sistema): o vendedor aqui é quem fez a venda, podendo
/// inclusive ser lançada por um usuário de outro perfil (ex.: estoquista).
model Vendedor {
  id             String        @id @default(uuid())
  grupoId        String        @map("grupo_id")
  nome           String
  ativo          Boolean       @default(true)
  recebeComissao Boolean       @default(false) @map("recebe_comissao")
  tipoComissao   TipoComissao? @map("tipo_comissao")
  valorComissao  Decimal?      @map("valor_comissao") @db.Decimal(14, 4)
  criadoEm       DateTime      @default(now()) @map("criado_em")

  grupo         GrupoEmpresarial @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  movimentacoes Movimentacao[]
  ordensServico OrdemServico[]
  lancamentos   Lancamento[]

  comissoes Comissao[] @relation("ComissaoVendedor")

  @@map("vendedores")
}

model Categoria {
  id       String   @id @default(uuid())
  grupoId  String   @map("grupo_id")
  nome     String
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  grupo    GrupoEmpresarial @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  produtos Produto[]

  @@unique([grupoId, nome])
  @@map("categorias")
}

model UnidadeMedida {
  id       String   @id @default(uuid())
  grupoId  String   @map("grupo_id")
  nome     String
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  grupo    GrupoEmpresarial @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  produtos Produto[]

  @@unique([grupoId, nome])
  @@map("unidades_medida")
}

/// Uma tabela de preços nomeada (ex.: "Varejo", "Atacado", "Promoção X") com um
/// preço de venda por produto. Ao escolher um cliente numa venda ou OS, a
/// tabela associada a ele (Cliente.tabelaPrecoPadraoId) é sugerida — sempre
/// editável. Sem versionamento: é um valor mutável, como Servico.precoPadrao.
model TabelaPreco {
  id       String   @id @default(uuid())
  grupoId  String   @map("grupo_id")
  nome     String
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  grupo    GrupoEmpresarial  @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  itens    ItemTabelaPreco[]
  clientes Cliente[]

  @@unique([grupoId, nome])
  @@map("tabelas_preco")
}

model ItemTabelaPreco {
  id            String  @id @default(uuid())
  tabelaPrecoId String  @map("tabela_preco_id")
  produtoId     String  @map("produto_id")
  preco         Decimal @db.Decimal(14, 2)

  tabelaPreco TabelaPreco @relation(fields: [tabelaPrecoId], references: [id], onDelete: Cascade)
  produto     Produto     @relation(fields: [produtoId], references: [id])

  @@unique([tabelaPrecoId, produtoId])
  @@map("tabela_preco_itens")
}

model Produto {
  id                String            @id @default(uuid())
  grupoId           String            @map("grupo_id")
  sku               String
  nome              String
  categoriaId       String            @map("categoria_id")
  marca             String?
  modelo            String?
  estadoConservacao EstadoConservacao @map("estado_conservacao")
  unidadeMedidaId   String            @map("unidade_medida_id")
  fotoUrl           String?           @map("foto_url")
  controlaEstoque   Boolean           @default(true) @map("controla_estoque")
  ativo             Boolean           @default(true)
  criadoEm          DateTime          @default(now()) @map("criado_em")

  grupo            GrupoEmpresarial          @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  categoria        Categoria                 @relation(fields: [categoriaId], references: [id])
  unidadeMedida    UnidadeMedida             @relation(fields: [unidadeMedidaId], references: [id])
  estoques         ProdutoEstoque[]
  movimentacoes    Movimentacao[]
  itensOS          ItemOrdemServicoProduto[]
  itensOrcamento   ItemOrcamento[]
  itensTabelaPreco ItemTabelaPreco[]
  itensLancamento  ItemLancamento[]

  @@unique([grupoId, sku])
  @@map("produtos")
}

model ProdutoEstoque {
  id              String   @id @default(uuid())
  produtoId       String   @map("produto_id")
  depositoId      String   @map("deposito_id")
  empresaId       String   @map("empresa_id")
  quantidadeSaldo Decimal  @default(0) @map("quantidade_saldo") @db.Decimal(14, 3)
  custoMedioAtual Decimal  @default(0) @map("custo_medio_atual") @db.Decimal(14, 4)
  valorTotalSaldo Decimal  @default(0) @map("valor_total_saldo") @db.Decimal(14, 2)
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  produto  Produto  @relation(fields: [produtoId], references: [id])
  deposito Deposito @relation(fields: [depositoId], references: [id])
  empresa  Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@unique([produtoId, depositoId])
  @@map("produto_estoque")
}

model Movimentacao {
  id                  String        @id @default(uuid())
  produtoId           String        @map("produto_id")
  depositoId          String        @map("deposito_id")
  empresaId           String        @map("empresa_id")
  grupoId             String        @map("grupo_id")
  tipoMovimento       TipoMovimento @map("tipo_movimento")
  dataMovimento       DateTime      @default(now()) @map("data_movimento")
  quantidade          Decimal       @db.Decimal(14, 3)
  custoUnitario       Decimal?      @map("custo_unitario") @db.Decimal(14, 4)
  custoMedioApos      Decimal       @map("custo_medio_apos") @db.Decimal(14, 4)
  saldoQuantidadeApos Decimal       @map("saldo_quantidade_apos") @db.Decimal(14, 3)
  saldoValorApos      Decimal       @map("saldo_valor_apos") @db.Decimal(14, 2)
  precoVenda          Decimal?      @map("preco_venda") @db.Decimal(14, 2)
  clienteId           String?       @map("cliente_id")
  fornecedorId        String?       @map("fornecedor_id")
  vendedorId          String?       @map("vendedor_id")
  usuarioId           String        @map("usuario_id")
  ordemServicoId      String?       @map("ordem_servico_id")
  orcamentoId         String?       @map("orcamento_id")
  lancamentoId        String?       @map("lancamento_id")
  observacao          String?
  estornadoEm         DateTime?     @map("estornado_em")
  estornoDeId         String?       @map("estorno_de_id")
  criadoEm            DateTime      @default(now()) @map("criado_em")

  produto      Produto          @relation(fields: [produtoId], references: [id])
  deposito     Deposito         @relation(fields: [depositoId], references: [id])
  empresa      Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  grupo        GrupoEmpresarial @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  cliente      Cliente?         @relation(fields: [clienteId], references: [id])
  fornecedor   Fornecedor?      @relation(fields: [fornecedorId], references: [id])
  vendedor     Vendedor?        @relation(fields: [vendedorId], references: [id])
  usuario      Usuario          @relation(fields: [usuarioId], references: [id])
  ordemServico OrdemServico?    @relation(fields: [ordemServicoId], references: [id])
  orcamento    Orcamento?       @relation(fields: [orcamentoId], references: [id])
  lancamento   Lancamento?      @relation(fields: [lancamentoId], references: [id])
  estornoDe    Movimentacao?    @relation("EstornoMovimentacao", fields: [estornoDeId], references: [id])
  estornos     Movimentacao[]   @relation("EstornoMovimentacao")

  @@index([produtoId, depositoId, dataMovimento])
  @@index([empresaId, dataMovimento])
  @@map("movimentacoes")
}

/// Lançamento de estoque avulso (fora de OS/Orçamento): agrupa itens de UM
/// único tipo de movimento sob um cabeçalho com status Aberto/Fechado, mesmo
/// critério de OS/Orçamento — enquanto aberto só existe o rascunho (nenhum
/// efeito no Kardex); "Finalizar" lança TODOS os itens de uma vez
/// (`finalizarLancamento`); "Cancelar Fechamento" estorna TODOS de uma vez
/// (`cancelarFechamentoLancamento`, reaproveitando `estornarMovimentoNaTransacao`
/// de src/lib/kardex.ts) e volta pra aberto, pronto pra editar e refechar.
/// Transferência é EXCEÇÃO deliberada: uma vez fechada, fica permanente (sem
/// "Cancelar Fechamento") — mesmo critério da conclusão de uma OS hoje.
model Lancamento {
  id                String           @id @default(uuid())
  numero            Int              @unique @default(autoincrement())
  tipo              TipoLancamento
  status            StatusLancamento @default(aberto)
  depositoId        String?          @map("deposito_id")
  depositoOrigemId  String?          @map("deposito_origem_id")
  depositoDestinoId String?          @map("deposito_destino_id")
  empresaId         String           @map("empresa_id")
  grupoId           String           @map("grupo_id")
  fornecedorId      String?          @map("fornecedor_id")
  clienteId         String?          @map("cliente_id")
  vendedorId        String?          @map("vendedor_id")
  usuarioId         String           @map("usuario_id")
  observacao        String?
  criadoEm          DateTime         @default(now()) @map("criado_em")
  fechadoEm         DateTime?        @map("fechado_em")
  reabertoEm        DateTime?        @map("reaberto_em")

  deposito        Deposito?        @relation("LancamentoDeposito", fields: [depositoId], references: [id])
  depositoOrigem  Deposito?        @relation("LancamentoDepositoOrigem", fields: [depositoOrigemId], references: [id])
  depositoDestino Deposito?        @relation("LancamentoDepositoDestino", fields: [depositoDestinoId], references: [id])
  empresa         Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  grupo           GrupoEmpresarial @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  fornecedor      Fornecedor?      @relation(fields: [fornecedorId], references: [id])
  cliente         Cliente?         @relation(fields: [clienteId], references: [id])
  vendedor        Vendedor?        @relation(fields: [vendedorId], references: [id])
  usuario         Usuario          @relation(fields: [usuarioId], references: [id])
  itens           ItemLancamento[]
  movimentacoes   Movimentacao[]

  @@index([empresaId, criadoEm])
  @@map("lancamentos")
}

model ItemLancamento {
  id            String   @id @default(uuid())
  lancamentoId  String   @map("lancamento_id")
  produtoId     String   @map("produto_id")
  quantidade    Decimal  @db.Decimal(14, 3)
  custoUnitario Decimal? @map("custo_unitario") @db.Decimal(14, 4)
  precoVenda    Decimal? @map("preco_venda") @db.Decimal(14, 2)

  lancamento Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  produto    Produto    @relation(fields: [produtoId], references: [id])

  @@map("lancamento_itens")
}

model Servico {
  id          String   @id @default(uuid())
  grupoId     String   @map("grupo_id")
  nome        String
  precoPadrao Decimal  @default(0) @map("preco_padrao") @db.Decimal(14, 2)
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em")

  grupo   GrupoEmpresarial          @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  itensOS ItemOrdemServicoServico[]

  @@unique([grupoId, nome])
  @@map("servicos")
}

model OrdemServico {
  id          String    @id @default(uuid())
  numero      Int       @unique @default(autoincrement())
  clienteId   String    @map("cliente_id")
  depositoId  String    @map("deposito_id")
  empresaId   String    @map("empresa_id")
  grupoId     String    @map("grupo_id")
  vendedorId  String    @map("vendedor_id")
  usuarioId   String    @map("usuario_id")
  status      StatusOS  @default(aberta)
  observacao  String?
  criadaEm    DateTime  @default(now()) @map("criada_em")
  concluidaEm DateTime? @map("concluida_em")

  cliente  Cliente          @relation(fields: [clienteId], references: [id])
  deposito Deposito         @relation(fields: [depositoId], references: [id])
  empresa  Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  grupo    GrupoEmpresarial @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  vendedor Vendedor         @relation(fields: [vendedorId], references: [id])
  usuario  Usuario          @relation(fields: [usuarioId], references: [id])

  itensProduto  ItemOrdemServicoProduto[]
  itensServico  ItemOrdemServicoServico[]
  movimentacoes Movimentacao[]

  @@index([empresaId, criadaEm])
  @@map("ordens_servico")
}

model ItemOrdemServicoProduto {
  id             String  @id @default(uuid())
  ordemServicoId String  @map("ordem_servico_id")
  produtoId      String  @map("produto_id")
  quantidade     Decimal @db.Decimal(14, 3)
  precoUnitario  Decimal @map("preco_unitario") @db.Decimal(14, 2)

  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  produto      Produto      @relation(fields: [produtoId], references: [id])

  @@map("os_itens_produto")
}

model ItemOrdemServicoServico {
  id             String  @id @default(uuid())
  ordemServicoId String  @map("ordem_servico_id")
  servicoId      String  @map("servico_id")
  quantidade     Decimal @default(1) @db.Decimal(14, 3)
  precoUnitario  Decimal @map("preco_unitario") @db.Decimal(14, 2)

  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  servico      Servico      @relation(fields: [servicoId], references: [id])

  @@map("os_itens_servico")
}

/// Orçamento de compra por rateio: o comprador informa o valor estimado de
/// venda de cada item e uma taxa de revenda (ou um valor total que pretende
/// pagar) — o sistema rateia esse total de compra entre os itens
/// proporcionalmente ao valor estimado de cada um (ver src/lib/orcamento.ts).
/// Ao finalizar, gera as entradas de compra no Kardex; cancelar o fechamento
/// gera o estorno exato dessas entradas e volta o orçamento para aberto.
model Orcamento {
  id                        String          @id @default(uuid())
  numero                    Int             @unique @default(autoincrement())
  descricao                 String?
  depositoId                String          @map("deposito_id")
  empresaId                 String          @map("empresa_id")
  grupoId                   String          @map("grupo_id")
  fornecedorId              String?         @map("fornecedor_id")
  usuarioId                 String          @map("usuario_id")
  status                    StatusOrcamento @default(aberto)
  taxaRevenda               Decimal?        @map("taxa_revenda") @db.Decimal(6, 3)
  valorCompraTotalInformado Decimal?        @map("valor_compra_total_informado") @db.Decimal(14, 2)
  criadoEm                  DateTime        @default(now()) @map("criado_em")
  fechadoEm                 DateTime?       @map("fechado_em")
  reabertoEm                DateTime?       @map("reaberto_em")

  deposito      Deposito         @relation(fields: [depositoId], references: [id])
  empresa       Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  grupo         GrupoEmpresarial @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  fornecedor    Fornecedor?      @relation(fields: [fornecedorId], references: [id])
  usuario       Usuario          @relation(fields: [usuarioId], references: [id])
  itens         ItemOrcamento[]
  movimentacoes Movimentacao[]

  @@index([empresaId, criadoEm])
  @@map("orcamentos")
}

model ItemOrcamento {
  id                  String   @id @default(uuid())
  orcamentoId         String   @map("orcamento_id")
  produtoId           String   @map("produto_id")
  quantidade          Decimal  @default(1) @db.Decimal(14, 3)
  valorEstimadoVenda  Decimal  @map("valor_estimado_venda") @db.Decimal(14, 2)
  custoCompraUnitario Decimal? @map("custo_compra_unitario") @db.Decimal(14, 4)

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  produto   Produto   @relation(fields: [produtoId], references: [id])

  @@map("orcamento_itens")
}

// ============================================================================
// MÓDULO FINANCEIRO
// ============================================================================
// Kardex financeiro: Contas a Pagar/Receber com baixa, conciliação bancária,
// rateio triplo (Plano Financeiro + Centro de Custo + Processo) e ledger
// append-only (MovimentacaoFinanceira), no mesmo espírito do Kardex de
// estoque acima. Ver NOTAS-financeiro.md (fora do repo) para o histórico de
// decisões desta sessão de design.
//
// Lancamento/TipoLancamento/StatusLancamento/Movimentacao já existem acima
// pra ESTOQUE (domínio diferente) — por isso os equivalentes financeiros
// levam o sufixo "Financeiro".
// ============================================================================

enum TipoLancamentoFinanceiro {
  receita
  despesa
}

enum NaturezaConta {
  sintetica
  analitica
}

enum NaturezaLancamento {
  real
  prevista
}

enum StatusLancamentoFinanceiro {
  aberto
  baixado
  estornado
  cancelado
}

enum TipoConta {
  conta_corrente
  caixa
  fundo_fixo
  aplicacao
}

enum TipoDocumento {
  especie
  cheque_vista
  cheque_prazo
  cheque_devolvido
  deposito_cartorio
  nota_promissoria
  deposito_bancario
  pix
  cartao
}

enum TipoTaxaCartao {
  a_vista
  antecipacao
  parc_estabelecimento
  parc_cliente
}

enum StatusRetencao {
  pendente
  recolhida
}

enum StatusComissao {
  pendente
  paga
}

enum TipoMovimentacaoFinanceira {
  baixa_receita
  baixa_despesa
  estorno_baixa
  transferencia_entrada
  transferencia_saida
  aplicacao_financeira
  resgate_aplicacao
  rendimento_aplicacao
  estorno_movimento_aplicacao
}

enum TipoMovimentoAplicacao {
  aplicacao_financeira
  resgate_aplicacao
  registro_rendimento
}

/// Categorização da transferência entre contas. emprestimo_contraido_banco
/// funciona hoje como transferência genérica — a geração automática de
/// parcelas futuras (LancamentoFinanceiro de despesa por parcela) fica fora
/// de escopo por enquanto.
enum TipoMovimentoTransferencia {
  transferencia_geral
  reposicao_fundo_fixo
  saldo_caixa_banco
  emprestimo_contraido_banco
  transferencia_entre_caixas
  transferencia_banco_para_caixa
}

enum StatusConciliacao {
  pendente
  conciliado
}

enum OrigemPendencia {
  manual
  importacao_extrato
}

enum TipoPendencia {
  entrada
  saida
}

model FechamentoDiario {
  id            String    @id @default(uuid())
  empresaId     String    @map("empresa_id")
  data          DateTime // dia fechado, sempre início do dia
  fechadoEm     DateTime  @default(now()) @map("fechado_em")
  fechadoPorId  String    @map("fechado_por_id")
  reabertoEm    DateTime? @map("reaberto_em")
  reabertoPorId String?   @map("reaberto_por_id")
  ativo         Boolean   @default(true) // false = foi reaberto

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@unique([empresaId, data])
  @@index([empresaId, ativo, data])
  @@map("fechamentos_diarios")
}

model Portador {
  id        String  @id @default(uuid())
  empresaId String  @map("empresa_id")
  nome      String
  ativo     Boolean @default(true)

  lancamentos LancamentoFinanceiro[]

  @@index([empresaId])
  @@map("portadores")
}

model AlineaDevolucaoCheque {
  id        String  @id @default(uuid())
  codigo    String  @unique // conforme tabela Bacen, ex: "11", "12", "13"
  descricao String
  ativo     Boolean @default(true)

  baixas   Baixa[]
  estornos Estorno[]

  @@map("alineas_devolucao_cheque")
}

model ContaFinanceira {
  id                     String    @id @default(uuid())
  empresaId              String    @map("empresa_id")
  tipo                   TipoConta
  nome                   String
  numeroConta            String?   @map("numero_conta")
  agencia                String?
  banco                  String?
  limiteCredito          Decimal?  @map("limite_credito") @db.Decimal(14, 2)
  dataAbertura           DateTime? @map("data_abertura")
  valorFundoFixo         Decimal?  @map("valor_fundo_fixo") @db.Decimal(14, 2) // teto, só relevante quando tipo = fundo_fixo
  saldoInicial           Decimal   @default(0) @map("saldo_inicial") @db.Decimal(14, 2)
  saldoAtual             Decimal   @default(0) @map("saldo_atual") @db.Decimal(14, 2)
  gerarBoleto            Boolean   @default(false) @map("gerar_boleto")
  adiantamentoCliente    Boolean   @default(false) @map("adiantamento_cliente") // conta é um controle de adiantamento de cliente específico
  adiantamentoFornecedor Boolean   @default(false) @map("adiantamento_fornecedor") // conta é um controle de adiantamento de fornecedor específico
  ativo                  Boolean   @default(true)
  criadoEm               DateTime  @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  lancamentosPrevistos       LancamentoFinanceiro[]      @relation("ContaPrevista")
  baixas                     Baixa[]
  estornos                   Estorno[]
  movimentacoesOrigem        MovimentacaoFinanceira[]    @relation("ContaOrigem")
  movimentacoesDestino       MovimentacaoFinanceira[]    @relation("ContaDestino")
  saldosMensais              SaldoMensalConta[]
  saldosAdiantamento         SaldoAdiantamentoTerceiro[]
  extratoBancarioLinhas      ExtratoBancarioLinha[]
  pendenciasConciliacao      PendenciaConciliacao[]
  movimentosAplicacaoOrigem  MovimentoAplicacao[]        @relation("MovAplicacaoOrigem")
  movimentosAplicacaoDestino MovimentoAplicacao[]        @relation("MovAplicacaoDestino")
  transferenciasOrigem       TransferenciaEntreContas[]  @relation("TransfOrigem")
  transferenciasDestino      TransferenciaEntreContas[]  @relation("TransfDestino")

  @@index([empresaId, tipo])
  @@map("contas_financeiras")
}

/// Resolve qual código do Plano Financeiro usar ao gravar a
/// MovimentacaoFinanceira de Aplicação/Resgate/Rendimento — um parâmetro por
/// empresa (não um "papel especial" no PlanoFinanceiro, nem uma "conta
/// contábil" por ContaFinanceira — as duas abordagens descartadas antes de
/// fechar esta). Campos opcionais porque a ContaFinanceira tipo aplicacao pode
/// existir antes de configurar isso — obrigatoriedade validada em Server
/// Action no momento de registrar um MovimentoAplicacao.
model ParametroFinanceiro {
  id                String   @id @default(uuid())
  empresaId         String   @unique @map("empresa_id")
  planoAplicacaoId  String?  @map("plano_aplicacao_id")
  planoResgateId    String?  @map("plano_resgate_id")
  planoRendimentoId String?  @map("plano_rendimento_id")
  atualizadoEm      DateTime @updatedAt @map("atualizado_em")

  empresa         Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  planoAplicacao  PlanoFinanceiro? @relation("ParamPlanoAplicacao", fields: [planoAplicacaoId], references: [id])
  planoResgate    PlanoFinanceiro? @relation("ParamPlanoResgate", fields: [planoResgateId], references: [id])
  planoRendimento PlanoFinanceiro? @relation("ParamPlanoRendimento", fields: [planoRendimentoId], references: [id])

  @@map("parametros_financeiros")
}

model MascaraPlanoFinanceiro {
  id      String  @id @default(uuid())
  grupoId String  @map("grupo_id")
  nome    String
  ativo   Boolean @default(true)

  grupo     GrupoEmpresarial  @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  segmentos MascaraSegmento[]
  planos    PlanoFinanceiro[]

  @@unique([grupoId, nome])
  @@map("mascaras_plano_financeiro")
}

model MascaraSegmento {
  id         String  @id @default(uuid())
  mascaraId  String  @map("mascara_id")
  ordem      Int
  qtdDigitos Int     @map("qtd_digitos")
  nome       String?

  mascara MascaraPlanoFinanceiro @relation(fields: [mascaraId], references: [id], onDelete: Cascade)

  @@unique([mascaraId, ordem])
  @@map("mascara_segmentos")
}

model PlanoFinanceiro {
  id        String                   @id @default(uuid())
  grupoId   String                   @map("grupo_id")
  mascaraId String                   @map("mascara_id")
  codigo    String
  descricao String
  tipo      TipoLancamentoFinanceiro
  natureza  NaturezaConta
  nivel     Int
  paiId     String?                  @map("pai_id")
  ativo     Boolean                  @default(true)
  criadoEm  DateTime                 @default(now()) @map("criado_em")

  grupo   GrupoEmpresarial       @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  mascara MascaraPlanoFinanceiro @relation(fields: [mascaraId], references: [id])
  pai     PlanoFinanceiro?       @relation("PlanoHierarquia", fields: [paiId], references: [id])
  filhos  PlanoFinanceiro[]      @relation("PlanoHierarquia")

  rateios              LancamentoRateio[]
  retencoes            Retencao[]
  movimentacoes        MovimentacaoFinanceira[]
  parametrosAplicacao  ParametroFinanceiro[]    @relation("ParamPlanoAplicacao")
  parametrosResgate    ParametroFinanceiro[]    @relation("ParamPlanoResgate")
  parametrosRendimento ParametroFinanceiro[]    @relation("ParamPlanoRendimento")

  @@unique([grupoId, codigo])
  @@index([paiId])
  @@map("planos_financeiros")
}

model MascaraCentroCusto {
  id      String  @id @default(uuid())
  grupoId String  @map("grupo_id")
  nome    String
  ativo   Boolean @default(true)

  grupo     GrupoEmpresarial             @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  segmentos MascaraCentroCustoSegmento[]
  centros   CentroCusto[]

  @@unique([grupoId, nome])
  @@map("mascaras_centro_custo")
}

model MascaraCentroCustoSegmento {
  id         String  @id @default(uuid())
  mascaraId  String  @map("mascara_id")
  ordem      Int
  qtdDigitos Int     @map("qtd_digitos")
  nome       String?

  mascara MascaraCentroCusto @relation(fields: [mascaraId], references: [id], onDelete: Cascade)

  @@unique([mascaraId, ordem])
  @@map("mascara_centro_custo_segmentos")
}

model CentroCusto {
  id        String        @id @default(uuid())
  grupoId   String        @map("grupo_id")
  mascaraId String        @map("mascara_id")
  codigo    String
  descricao String
  natureza  NaturezaConta
  nivel     Int
  paiId     String?       @map("pai_id")
  ativo     Boolean       @default(true)

  grupo   GrupoEmpresarial   @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  mascara MascaraCentroCusto @relation(fields: [mascaraId], references: [id])
  pai     CentroCusto?       @relation("CentroCustoHierarquia", fields: [paiId], references: [id])
  filhos  CentroCusto[]      @relation("CentroCustoHierarquia")

  rateios LancamentoRateioCentroCusto[]

  @@unique([grupoId, codigo])
  @@index([paiId])
  @@map("centros_custo")
}

model MascaraProcesso {
  id      String @id @default(uuid())
  grupoId String @map("grupo_id")
  nome    String

  grupo     GrupoEmpresarial          @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  segmentos MascaraProcessoSegmento[]
  processos Processo[]

  @@unique([grupoId, nome])
  @@map("mascaras_processo")
}

model MascaraProcessoSegmento {
  id         String  @id @default(uuid())
  mascaraId  String  @map("mascara_id")
  ordem      Int
  qtdDigitos Int     @map("qtd_digitos")
  nome       String?

  mascara MascaraProcesso @relation(fields: [mascaraId], references: [id], onDelete: Cascade)

  @@unique([mascaraId, ordem])
  @@map("mascara_processo_segmentos")
}

model Processo {
  id         String   @id @default(uuid())
  empresaId  String   @map("empresa_id")
  mascaraId  String   @map("mascara_id")
  nome       String
  dataInicio DateTime @map("data_inicio")
  dataFim    DateTime @map("data_fim")
  padrao     Boolean  @default(false) // marca o processo padrão do sistema (1 por empresa)
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now()) @map("criado_em")

  empresa Empresa         @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  mascara MascaraProcesso @relation(fields: [mascaraId], references: [id])

  itens       ProcessoItem[]
  lancamentos LancamentoFinanceiro[]

  // Restrição de "só 1 padrao=true por empresa" implementada via índice único
  // parcial na migration: CREATE UNIQUE INDEX ... WHERE padrao = true
  @@index([empresaId])
  @@map("processos")
}

model ProcessoItem {
  id         String        @id @default(uuid())
  processoId String        @map("processo_id")
  codigo     String
  descricao  String
  natureza   NaturezaConta
  nivel      Int
  paiId      String?       @map("pai_id")
  ativo      Boolean       @default(true)

  processo Processo       @relation(fields: [processoId], references: [id], onDelete: Cascade)
  pai      ProcessoItem?  @relation("ProcessoItemHierarquia", fields: [paiId], references: [id])
  filhos   ProcessoItem[] @relation("ProcessoItemHierarquia")

  rateios LancamentoRateioProcesso[]

  @@unique([processoId, codigo])
  @@map("processo_itens")
}

/// Lançamento financeiro (Despesa/Receita) com contas a pagar/receber. Ver
/// nota de topo do módulo — renomeado de "Lancamento" por colisão com o
/// lançamento de estoque acima.
model LancamentoFinanceiro {
  id           String                     @id @default(uuid())
  empresaId    String                     @map("empresa_id")
  tipo         TipoLancamentoFinanceiro
  status       StatusLancamentoFinanceiro @default(aberto)
  natureza     NaturezaLancamento
  convertidoEm DateTime?                  @map("convertido_em") // quando Prevista virou Real

  historicoSimplificado String  @map("historico_simplificado")
  historicoComplementar String? @map("historico_complementar")
  documento             String?
  documentoFisico       Boolean @default(false) @map("documento_fisico") // boleto/comprovante está fisicamente com a empresa

  tipoDocumento   TipoDocumento
  portadorId      String?       @map("portador_id")
  contaPrevistaId String?       @map("conta_prevista_id")

  // Contraparte: nunca as duas juntas — populado conforme o cadastro escolhido.
  clienteId    String? @map("cliente_id")
  fornecedorId String? @map("fornecedor_id")

  valorOriginal  Decimal  @map("valor_original") @db.Decimal(14, 2)
  dataEmissao    DateTime @map("data_emissao")
  dataVencimento DateTime @map("data_vencimento")
  dataMovimento  DateTime @map("data_movimento") // snapshot do último fechamento ativo no momento da criação
  moraMes        Decimal? @map("mora_mes") @db.Decimal(5, 2) // taxa de mora mensal (%): juros = valor × (moraMes/30) × diasAtraso

  processoId String @map("processo_id")

  observacao String?
  criadoEm   DateTime @default(now()) @map("criado_em")

  empresa       Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  portador      Portador?        @relation(fields: [portadorId], references: [id])
  contaPrevista ContaFinanceira? @relation("ContaPrevista", fields: [contaPrevistaId], references: [id])
  cliente       Cliente?         @relation(fields: [clienteId], references: [id])
  fornecedor    Fornecedor?      @relation(fields: [fornecedorId], references: [id])
  processo      Processo         @relation(fields: [processoId], references: [id])

  rateios             LancamentoRateio[]
  rateiosProcesso     LancamentoRateioProcesso[]
  retencoes           Retencao[]                 @relation("RetencaoOrigem")
  retencoesRecolhidas Retencao[]                 @relation("RetencaoRecolhida")
  comissoes           Comissao[]                 @relation("ComissaoOrigem")
  comissoesPagas      Comissao[]                 @relation("ComissaoPaga")
  // Deixou de ser 1:1 na leva de Estorno — um Lançamento pode acumular várias
  // Baixas ao longo do tempo (uma estornada, outra nova depois). Só uma pode
  // estar "ativa" (não estornada) por vez — garantido por um índice único
  // parcial (WHERE estornada = false), não pelo Prisma. Decisão revisitada
  // deliberadamente: a sessão de design original tinha fechado isso como 1:1.
  baixas              Baixa[]
  dadosCheque         DadosCheque?
  dadosCartao         DadosCartao?
  movimentacoes       MovimentacaoFinanceira[]

  @@index([empresaId, status])
  @@index([empresaId, tipo, natureza])
  @@index([processoId])
  @@map("lancamentos_financeiros")
}

/// Rateio por Plano de Contas — soma 100% do LancamentoFinanceiro.
model LancamentoRateio {
  id           String  @id @default(uuid())
  lancamentoId String  @map("lancamento_id")
  planoId      String  @map("plano_id")
  percentual   Decimal @db.Decimal(5, 2)
  valor        Decimal @db.Decimal(14, 2)

  lancamento LancamentoFinanceiro @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  plano      PlanoFinanceiro      @relation(fields: [planoId], references: [id])

  rateiosCentroCusto LancamentoRateioCentroCusto[]

  @@unique([lancamentoId, planoId])
  @@map("lancamento_rateios")
}

/// Sub-rateio por Centro de Custo — soma 100% do LancamentoRateio pai (não do lançamento inteiro).
model LancamentoRateioCentroCusto {
  id                 String  @id @default(uuid())
  lancamentoRateioId String  @map("lancamento_rateio_id")
  centroCustoId      String  @map("centro_custo_id")
  percentual         Decimal @db.Decimal(5, 2)
  valor              Decimal @db.Decimal(14, 2)

  lancamentoRateio LancamentoRateio @relation(fields: [lancamentoRateioId], references: [id], onDelete: Cascade)
  centroCusto      CentroCusto      @relation(fields: [centroCustoId], references: [id])

  @@unique([lancamentoRateioId, centroCustoId])
  @@map("lancamento_rateio_centro_custo")
}

/// Rateio por Item de Processo — soma 100% do LancamentoFinanceiro, em árvore paralela ao Plano de Contas.
model LancamentoRateioProcesso {
  id             String  @id @default(uuid())
  lancamentoId   String  @map("lancamento_id")
  processoItemId String  @map("processo_item_id")
  percentual     Decimal @db.Decimal(5, 2)
  valor          Decimal @db.Decimal(14, 2)

  lancamento   LancamentoFinanceiro @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  processoItem ProcessoItem         @relation(fields: [processoItemId], references: [id])

  @@unique([lancamentoId, processoItemId])
  @@map("lancamento_rateio_processo")
}

/// Retenção — percentuais independentes (não fecham 100% entre si). Regra de
/// negócio (aplicada em Server Action, não no schema): só se aplica
/// recolhimento a retenções de despesa (retenção de receita é obrigação do
/// cliente, nunca gera recolhimento); um recolhimento só pode agrupar
/// retenções do MESMO planoId (não misturar tributos diferentes numa guia).
model Retencao {
  id             String         @id @default(uuid())
  lancamentoId   String         @map("lancamento_id")
  planoId        String         @map("plano_id") // ex: código de tributo retido
  percentual     Decimal        @db.Decimal(5, 2)
  valor          Decimal        @db.Decimal(14, 2)
  status         StatusRetencao @default(pendente)
  recolhimentoId String?        @map("recolhimento_id")
  criadoEm       DateTime       @default(now()) @map("criado_em")

  lancamento   LancamentoFinanceiro  @relation("RetencaoOrigem", fields: [lancamentoId], references: [id])
  plano        PlanoFinanceiro       @relation(fields: [planoId], references: [id])
  recolhimento LancamentoFinanceiro? @relation("RetencaoRecolhida", fields: [recolhimentoId], references: [id])

  @@map("retencoes")
}

/// Comissão de venda sobre Receita — vendedorId aponta pro model Vendedor que
/// já existe no schema (grupoId, com recebeComissao/tipoComissao/
/// valorComissao já configurados), o mesmo cadastro referenciado em
/// OrdemServico.vendedorId. percentual/valor aqui são o snapshot congelado no
/// momento da venda/OS, sourced da config do Vendedor mas gravado por linha
/// (mesmo padrão de "congelar valor" de ItemOrcamento.custoCompraUnitario).
model Comissao {
  id           String         @id @default(uuid())
  lancamentoId String         @map("lancamento_id")
  vendedorId   String         @map("vendedor_id")
  percentual   Decimal        @db.Decimal(5, 2)
  valor        Decimal        @db.Decimal(14, 2)
  status       StatusComissao @default(pendente)
  pagamentoId  String?        @map("pagamento_id")
  criadoEm     DateTime       @default(now()) @map("criado_em")

  lancamento LancamentoFinanceiro  @relation("ComissaoOrigem", fields: [lancamentoId], references: [id])
  vendedor   Vendedor              @relation("ComissaoVendedor", fields: [vendedorId], references: [id])
  pagamento  LancamentoFinanceiro? @relation("ComissaoPaga", fields: [pagamentoId], references: [id])

  @@map("comissoes")
}

model DadosCheque {
  id            String  @id @default(uuid())
  lancamentoId  String  @unique @map("lancamento_id")
  banco         String?
  agencia       String?
  numeroCheque  String? @map("numero_cheque")
  contaCorrente String? @map("conta_corrente")
  cgc           String?
  cpf           String?
  telefone      String?

  // Terceiro dono do cheque: nunca os dois juntos.
  terceiroClienteId    String? @map("terceiro_cliente_id")
  terceiroFornecedorId String? @map("terceiro_fornecedor_id")

  lancamento         LancamentoFinanceiro @relation(fields: [lancamentoId], references: [id])
  terceiroCliente    Cliente?             @relation(fields: [terceiroClienteId], references: [id])
  terceiroFornecedor Fornecedor?          @relation(fields: [terceiroFornecedorId], references: [id])

  @@map("dados_cheque")
}

model DadosCartao {
  id                String          @id @default(uuid())
  lancamentoId      String          @unique @map("lancamento_id")
  operadora         String?
  numeroCartao      String?         @map("numero_cartao")
  loteRv            String?         @map("lote_rv")
  numeroAutorizacao String?         @map("numero_autorizacao")
  tipoTaxa          TipoTaxaCartao? @map("tipo_taxa")

  lancamento LancamentoFinanceiro @relation(fields: [lancamentoId], references: [id])

  @@map("dados_cartao")
}

model Baixa {
  id                    String   @id @default(uuid())
  // Não é mais @unique — ver comentário em LancamentoFinanceiro.baixas. A
  // invariante "só uma Baixa ativa por lançamento" é um índice único parcial
  // (WHERE estornada = false), fora do alcance do Prisma 7.10 instalado.
  lancamentoId          String   @map("lancamento_id")
  contaId               String   @map("conta_id")
  valorBaixado          Decimal  @map("valor_baixado") @db.Decimal(14, 2)
  dataBaixa             DateTime @map("data_baixa")
  juros                 Decimal  @default(0) @db.Decimal(14, 2)
  multa                 Decimal  @default(0) @db.Decimal(14, 2)
  desconto              Decimal  @default(0) @db.Decimal(14, 2)
  historicoComplementar String?  @map("historico_complementar")
  alineaDevolucaoId     String?  @map("alinea_devolucao_id")
  estornada             Boolean  @default(false)
  movimentacaoId        String   @unique @map("movimentacao_id")

  lancamento      LancamentoFinanceiro   @relation(fields: [lancamentoId], references: [id])
  conta           ContaFinanceira        @relation(fields: [contaId], references: [id])
  alineaDevolucao AlineaDevolucaoCheque? @relation(fields: [alineaDevolucaoId], references: [id])
  movimentacao    MovimentacaoFinanceira @relation("MovimentacaoBaixa", fields: [movimentacaoId], references: [id])

  estorno               Estorno?
  chequesUtilizados     ChequeTerceiroUtilizado[] @relation("DespesaPagaComCheque")
  utilizadoComoChequeEm ChequeTerceiroUtilizado?  @relation("ChequeUtilizadoEmDespesa")

  @@index([contaId, dataBaixa])
  @@index([lancamentoId])
  @@map("baixas")
}

/// Cheque de terceiro recebido (Receita) utilizado para pagar uma Despesa pelo Caixa.
model ChequeTerceiroUtilizado {
  id             String   @id @default(uuid())
  baixaDespesaId String   @map("baixa_despesa_id")
  baixaChequeId  String   @unique @map("baixa_cheque_id") // um cheque só pode ser usado em UMA despesa
  criadoEm       DateTime @default(now()) @map("criado_em")

  baixaDespesa Baixa @relation("DespesaPagaComCheque", fields: [baixaDespesaId], references: [id])
  baixaCheque  Baixa @relation("ChequeUtilizadoEmDespesa", fields: [baixaChequeId], references: [id])

  @@map("cheques_terceiro_utilizados")
}

model Estorno {
  id                String   @id @default(uuid())
  baixaId           String   @unique @map("baixa_id")
  contaId           String   @map("conta_id") // pode diferir da conta da Baixa original (ex: estorno de cheque = sempre banco)
  motivo            String
  dataEstorno       DateTime @map("data_estorno")
  alineaDevolucaoId String?  @map("alinea_devolucao_id")
  movimentacaoId    String   @unique @map("movimentacao_id")
  criadoEm          DateTime @default(now()) @map("criado_em")

  baixa           Baixa                  @relation(fields: [baixaId], references: [id])
  conta           ContaFinanceira        @relation(fields: [contaId], references: [id])
  alineaDevolucao AlineaDevolucaoCheque? @relation(fields: [alineaDevolucaoId], references: [id])
  movimentacao    MovimentacaoFinanceira @relation("MovimentacaoEstorno", fields: [movimentacaoId], references: [id])

  @@map("estornos_financeiros")
}

model TransferenciaEntreContas {
  id             String                     @id @default(uuid())
  empresaId      String                     @map("empresa_id")
  tipoMovimento  TipoMovimentoTransferencia @default(transferencia_geral) @map("tipo_movimento")
  contaOrigemId  String                     @map("conta_origem_id")
  contaDestinoId String                     @map("conta_destino_id")
  valor          Decimal                    @db.Decimal(14, 2)
  historico      String?
  data           DateTime
  estornada      Boolean                    @default(false)

  // Terceiro do adiantamento: exigido em Server Action conforme a flag da
  // contaDestino (adiantamentoCliente -> clienteId; adiantamentoFornecedor ->
  // fornecedorId). Nunca os dois juntos; ambos null fora desse cenário.
  clienteId    String? @map("cliente_id")
  fornecedorId String? @map("fornecedor_id")

  movSaidaId   String   @unique @map("mov_saida_id")
  movEntradaId String   @unique @map("mov_entrada_id")
  criadoEm     DateTime @default(now()) @map("criado_em")

  empresa      Empresa                @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  contaOrigem  ContaFinanceira        @relation("TransfOrigem", fields: [contaOrigemId], references: [id])
  contaDestino ContaFinanceira        @relation("TransfDestino", fields: [contaDestinoId], references: [id])
  cliente      Cliente?               @relation(fields: [clienteId], references: [id])
  fornecedor   Fornecedor?            @relation(fields: [fornecedorId], references: [id])
  movSaida     MovimentacaoFinanceira @relation("TransferenciaMovSaida", fields: [movSaidaId], references: [id])
  movEntrada   MovimentacaoFinanceira @relation("TransferenciaMovEntrada", fields: [movEntradaId], references: [id])

  @@map("transferencias_entre_contas")
}

/// Aplicação/Resgate/Rendimento: movimento simples, NÃO gera LancamentoFinanceiro.
/// O código do Plano Financeiro usado na MovimentacaoFinanceira gerada vem de
/// ParametroFinanceiro (conforme tipoMovimento), resolvido em Server Action.
model MovimentoAplicacao {
  id            String                 @id @default(uuid())
  empresaId     String                 @map("empresa_id")
  tipoMovimento TipoMovimentoAplicacao @map("tipo_movimento")
  daContaId     String?                @map("da_conta_id") // null quando tipoMovimento = registro_rendimento
  paraContaId   String                 @map("para_conta_id")
  valor         Decimal                @db.Decimal(14, 2)
  dataMovimento DateTime               @map("data_movimento")
  estornado     Boolean                @default(false)
  criadoEm      DateTime               @default(now()) @map("criado_em")

  empresa   Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  daConta   ContaFinanceira? @relation("MovAplicacaoOrigem", fields: [daContaId], references: [id])
  paraConta ContaFinanceira  @relation("MovAplicacaoDestino", fields: [paraContaId], references: [id])

  movimentacoes MovimentacaoFinanceira[]

  @@map("movimentos_aplicacao")
}

/// Ledger financeiro append-only, mesmo padrão do model Movimentacao (estoque)
/// acima — renomeado por colisão de nome, ver nota de topo do módulo.
model MovimentacaoFinanceira {
  id                   String                     @id @default(uuid())
  empresaId            String                     @map("empresa_id")
  contaId              String                     @map("conta_id")
  contaDestinoId       String?                    @map("conta_destino_id") // preenchido em transferências, para rastreio cruzado
  tipo                 TipoMovimentacaoFinanceira
  valor                Decimal                    @db.Decimal(14, 2) // com sinal (positivo=entrada, negativo=saída)
  saldoAnterior        Decimal                    @map("saldo_anterior") @db.Decimal(14, 2) // recomputável em cadeia (lançamento retroativo)
  saldoPosterior       Decimal                    @map("saldo_posterior") @db.Decimal(14, 2) // recomputável em cadeia (lançamento retroativo)
  lancamentoId         String?                    @map("lancamento_id") // preenchido quando vem de LancamentoFinanceiro normal (acessa rateios)
  movimentoAplicacaoId String?                    @map("movimento_aplicacao_id")
  planoId              String?                    @map("plano_id") // preenchido direto quando NÃO vem de LancamentoFinanceiro (ex: MovimentoAplicacao)
  clienteId            String?                    @map("cliente_id")
  fornecedorId         String?                    @map("fornecedor_id")
  documento            String?
  descricao            String
  statusConciliacao    StatusConciliacao          @default(pendente) @map("status_conciliacao")
  conciliadoEm         DateTime?                  @map("conciliado_em")
  extratoBancarioId    String?                    @map("extrato_bancario_id")
  criadoEm             DateTime                   @default(now()) @map("criado_em")

  empresa            Empresa               @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  conta              ContaFinanceira       @relation("ContaOrigem", fields: [contaId], references: [id])
  contaDestino       ContaFinanceira?      @relation("ContaDestino", fields: [contaDestinoId], references: [id])
  lancamento         LancamentoFinanceiro? @relation(fields: [lancamentoId], references: [id])
  movimentoAplicacao MovimentoAplicacao?   @relation(fields: [movimentoAplicacaoId], references: [id])
  plano              PlanoFinanceiro?      @relation(fields: [planoId], references: [id])
  cliente            Cliente?              @relation(fields: [clienteId], references: [id])
  fornecedor         Fornecedor?           @relation(fields: [fornecedorId], references: [id])
  extratoBancario    ExtratoBancarioLinha? @relation(fields: [extratoBancarioId], references: [id])

  baixa                Baixa?                    @relation("MovimentacaoBaixa")
  estorno              Estorno?                  @relation("MovimentacaoEstorno")
  transferenciaSaida   TransferenciaEntreContas? @relation("TransferenciaMovSaida")
  transferenciaEntrada TransferenciaEntreContas? @relation("TransferenciaMovEntrada")

  @@index([empresaId, contaId, criadoEm])
  @@index([contaId, statusConciliacao])
  @@map("movimentacoes_financeiras")
}

model SaldoMensalConta {
  id           String   @id @default(uuid())
  contaId      String   @map("conta_id")
  competencia  DateTime // sempre dia 1 do mês, ex: 2026-01-01
  saldoInicial Decimal  @map("saldo_inicial") @db.Decimal(14, 2)
  saldoFinal   Decimal  @map("saldo_final") @db.Decimal(14, 2)
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  conta ContaFinanceira @relation(fields: [contaId], references: [id])

  @@unique([contaId, competencia])
  @@map("saldos_mensais_conta")
}

/// Sub-razão de saldo por Cliente/Fornecedor, para contas marcadas como
/// adiantamentoCliente/adiantamentoFornecedor. Um dos dois campos, nunca os
/// dois — determinado pela flag da ContaFinanceira no momento do lançamento.
model SaldoAdiantamentoTerceiro {
  id           String   @id @default(uuid())
  contaId      String   @map("conta_id")
  clienteId    String?  @map("cliente_id")
  fornecedorId String?  @map("fornecedor_id")
  saldoAtual   Decimal  @default(0) @map("saldo_atual") @db.Decimal(14, 2)
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  conta      ContaFinanceira @relation(fields: [contaId], references: [id])
  cliente    Cliente?        @relation(fields: [clienteId], references: [id])
  fornecedor Fornecedor?     @relation(fields: [fornecedorId], references: [id])

  @@unique([contaId, clienteId])
  @@unique([contaId, fornecedorId])
  @@map("saldos_adiantamento_terceiro")
}

/// Linha do extrato bancário real (importado ou digitado).
model ExtratoBancarioLinha {
  id        String          @id @default(uuid())
  contaId   String          @map("conta_id")
  data      DateTime
  descricao String
  valor     Decimal         @db.Decimal(14, 2) // positivo=entrada, negativo=saída
  origem    OrigemPendencia
  criadoEm  DateTime        @default(now()) @map("criado_em")

  conta ContaFinanceira @relation(fields: [contaId], references: [id])

  movimentacoes MovimentacaoFinanceira[]

  @@map("extrato_bancario_linhas")
}

/// Pendência tipo "Banco": valor no extrato real ainda não identificado pela empresa.
model PendenciaConciliacao {
  id           String          @id @default(uuid())
  contaId      String          @map("conta_id")
  tipo         TipoPendencia
  data         DateTime
  valor        Decimal         @db.Decimal(14, 2)
  comentario   String?
  origem       OrigemPendencia
  resolvidoEm  DateTime?       @map("resolvido_em")
  lancamentoId String?         @map("lancamento_id") // preenchido quando a pendência é finalmente identificada e vira LancamentoFinanceiro
  criadoEm     DateTime        @default(now()) @map("criado_em")

  conta ContaFinanceira @relation(fields: [contaId], references: [id])

  @@map("pendencias_conciliacao")
}
